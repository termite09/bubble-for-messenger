{
  "name": "bubble-for-messenger",
  "version": "2.3.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Facebook Messenger as a floating chat head for macOS",
  "homepage": "https://github.com/termite09/bubble-for-messenger",
  "repository": {
    "type": "git",
    "url": "https://github.com/termite09/bubble-for-messenger.git"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --mac"
  },
  "author": "Alexandros Christou (fork of stefanminch/messenger-mac)",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.termite09.bubble-for-messenger",
    "productName": "Bubble",
    "files": [
      "src/**",
      "assets/icon.png"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "electronLanguages": [
        "en"
      ]
    },
    "compression": "maximum"
  }
}
