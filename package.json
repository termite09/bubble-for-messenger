{
  "name": "messenger-app",
  "version": "1.3.0",
  "description": "Facebook Messenger as a floating chat-head bubble for macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --mac"
  },
  "author": "Termite (fork of stefanminch/messenger-mac)",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.termite.messenger-bubble",
    "productName": "MessengerBubble",
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    }
  }
}
